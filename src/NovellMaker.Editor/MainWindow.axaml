<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NovellMaker.Editor.ViewModels"
        xmlns:views="using:NovellMaker.Editor.Views"
        x:Class="NovellMaker.Editor.MainWindow"
        x:DataType="vm:EditorSession"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseProjectCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshGitCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
  </Window.KeyBindings>
  <Window.DataTemplates>
    <DataTemplate DataType="vm:ProjectDocumentViewModel">
      <views:ProjectSettingsView DataContext="{Binding Session}" />
    </DataTemplate>
    <DataTemplate DataType="vm:SceneDocumentViewModel">
      <views:SceneEditorView />
    </DataTemplate>
    <DataTemplate DataType="vm:AssetLibraryDocumentViewModel">
      <views:AssetLibraryView DataContext="{Binding Session}" />
    </DataTemplate>
  </Window.DataTemplates>
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="#292C31">
      <MenuItem Header="_Файл">
        <MenuItem Header="_Создать проект" Command="{Binding NewCommand}" InputGesture="Ctrl+N" />
        <MenuItem Header="_Открыть проект…" Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
        <Separator />
        <MenuItem Header="Со_хранить" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
        <MenuItem Header="Сохранить _как…" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
        <MenuItem Header="_Закрыть проект" Command="{Binding CloseProjectCommand}" InputGesture="Ctrl+W" />
        <Separator />
        <MenuItem Header="_Выход" Click="ExitClicked" />
      </MenuItem>
      <MenuItem Header="_Правка">
        <MenuItem Header="_Отменить" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
        <MenuItem Header="_Повторить" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
      </MenuItem>
      <MenuItem Header="_Сцена">
        <MenuItem Header="_Добавить сцену" Command="{Binding AddSceneCommand}" />
        <MenuItem Header="_Удалить текущую сцену" Command="{Binding DeleteSceneCommand}" />
      </MenuItem>
      <MenuItem Header="_Вид">
        <MenuItem Header="_Обновить ресурсы и Git" Command="{Binding RefreshGitCommand}" InputGesture="F5" />
      </MenuItem>
      <MenuItem Header="_Ресурсы">
        <MenuItem Header="_Библиотека изображений" Command="{Binding OpenAssetLibraryCommand}" />
        <MenuItem Header="_Импортировать изображение…" Command="{Binding ImportImageCommand}" />
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" Background="#26292E" BorderBrush="#383C43" BorderThickness="0,0,0,1" Padding="8,5">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Name="NewProjectButton" Classes="tool" Content="Создать проект" Command="{Binding NewCommand}" />
        <Button Name="OpenProjectButton" Classes="tool" Content="Открыть…" Command="{Binding OpenCommand}" />
        <Button Name="SaveProjectButton" Classes="tool" Content="Сохранить" Command="{Binding SaveCommand}" />
        <Border Width="1" Background="#444951" Margin="8,3" />
        <Button Name="AddSceneButton" Classes="tool" Content="Добавить сцену" Command="{Binding AddSceneCommand}" />
        <Button Classes="tool" Content="Отменить" Command="{Binding UndoCommand}" />
        <Button Classes="tool" Content="Повторить" Command="{Binding RedoCommand}" />
        <Button Name="AssetLibraryButton" Classes="tool" Content="Ресурсы" Command="{Binding OpenAssetLibraryCommand}" />
        <Button Classes="tool" Content="Обновить" Command="{Binding RefreshGitCommand}" ToolTip.Tip="Обновить ресурсы и статус Git (F5)" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="#383C43" BorderThickness="0,1,0,0" Background="#26292E" Padding="12,7">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding GitSummary}" Classes="muted" Margin="20,0,0,0" MaxWidth="460" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GitSummary}" />
      </Grid>
    </Border>
    <Grid RowDefinitions="*,5,150">
      <Grid ColumnDefinitions="250,5,*,5,260">
        <Border Background="#24262B">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="#2A2D32" Padding="12,10">
              <TextBlock Text="ОБОЗРЕВАТЕЛЬ ПРОЕКТА" Classes="section" />
            </Border>
            <TextBlock DockPanel.Dock="Bottom" Margin="12" Classes="muted" FontSize="11" TextWrapping="Wrap"
                       Text="Git: первый столбец — индекс, второй — рабочая копия. M — изменён, A — добавлен, D — удалён, R — переименован, ?? — новый."
                       IsVisible="{Binding HasProject}" />
            <TreeView Name="ProjectExplorer" ItemsSource="{Binding Explorer}" Margin="4,8" IsEnabled="{Binding IsIdle}" SelectionChanged="ExplorerSelectionChanged">
              <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="vm:ExplorerEntry" ItemsSource="{Binding Children}">
                  <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
              <TreeView.Styles>
                <Style Selector="TreeViewItem">
                  <Setter Property="IsExpanded" Value="True" />
                </Style>
              </TreeView.Styles>
            </TreeView>
          </DockPanel>
        </Border>
        <GridSplitter Grid.Column="1" Background="#363A40" ResizeDirection="Columns" />
        <Grid Grid.Column="2" Background="#202226">
          <StackPanel IsVisible="{Binding !HasProject}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="430" Margin="32">
            <TextBlock Text="NovellMaker" FontSize="28" FontWeight="Light" />
            <TextBlock Text="Создайте проект новеллы или откройте существующий файл проекта." Classes="muted" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Создать проект" Command="{Binding NewCommand}" />
              <Button Content="Открыть…" Command="{Binding OpenCommand}" />
            </StackPanel>
          </StackPanel>
          <TabControl Name="Documents" IsVisible="{Binding HasProject}" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument, Mode=TwoWay}">
            <TabControl.ItemTemplate>
              <DataTemplate DataType="vm:DocumentViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Header}" FontSize="13" VerticalAlignment="Center" />
                  <Button Content="×" Padding="4,0" Background="Transparent" IsVisible="{Binding CanClose}" Command="{Binding CloseCommand}" ToolTip.Tip="Закрыть вкладку" AutomationProperties.Name="Закрыть вкладку" />
                </StackPanel>
              </DataTemplate>
            </TabControl.ItemTemplate>
          </TabControl>
        </Grid>
        <GridSplitter Grid.Column="3" Background="#363A40" ResizeDirection="Columns" />
        <Border Grid.Column="4" Background="#24262B">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="#2A2D32" Padding="12,10">
              <TextBlock Text="СВЕДЕНИЯ О ПРОЕКТЕ" Classes="section" />
            </Border>
            <ScrollViewer IsVisible="{Binding HasProject}">
              <StackPanel Margin="14,18" Spacing="10">
                <TextBlock Text="Идентификатор" Classes="section" />
                <SelectableTextBlock Text="{Binding ProjectId}" TextWrapping="Wrap" FontSize="12" />
                <TextBlock Text="Версия формата" Classes="section" Margin="0,8,0,0" />
                <TextBlock Text="{Binding FormatVersion}" />
                <TextBlock Text="Сцена" Classes="section" Margin="0,8,0,0" />
                <SelectableTextBlock Text="{Binding SelectedSceneId}" TextWrapping="Wrap" FontSize="11" />
                <TextBlock Text="Реплика" Classes="section" />
                <SelectableTextBlock Text="{Binding SelectedLineId}" TextWrapping="Wrap" FontSize="11" />
                <TextBlock Text="Ключ текста" Classes="section" />
                <SelectableTextBlock Text="{Binding SelectedTextKey}" TextWrapping="Wrap" FontSize="11" />
                <TextBlock Text="Состояние Git" Classes="section" Margin="0,8,0,0" />
                <TextBlock Text="{Binding GitSummary}" TextWrapping="Wrap" />
                <TextBlock Text="Символ * отмечает несохранённые изменения проекта. Git показывает изменения файлов на диске." Classes="muted" TextWrapping="Wrap" FontSize="12" Margin="0,16,0,0" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
      <GridSplitter Grid.Row="1" Background="#363A40" ResizeDirection="Rows" />
      <DockPanel Grid.Row="2" Background="#24262B">
        <Border DockPanel.Dock="Top" Background="#2A2D32" Padding="12,8">
          <TextBlock Text="СООБЩЕНИЯ" Classes="section" />
        </Border>
        <ListBox Name="DiagnosticsList" ItemsSource="{Binding Diagnostics}" Background="Transparent" FontSize="12" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
