<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NovellMaker.Editor.ViewModels"
        xmlns:views="using:NovellMaker.Editor.Views"
        x:Class="NovellMaker.Editor.MainWindow"
        x:DataType="vm:EditorSession"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseProjectCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshGitCommand}" />
    <KeyBinding Gesture="F6" Command="{Binding PreviewSceneCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
  </Window.KeyBindings>
  <Window.DataTemplates>
    <DataTemplate DataType="vm:ProjectDocumentViewModel">
      <views:ProjectSettingsView DataContext="{Binding Session}" />
    </DataTemplate>
    <DataTemplate DataType="vm:SceneDocumentViewModel">
      <views:SceneEditorView />
    </DataTemplate>
    <DataTemplate DataType="vm:AssetLibraryDocumentViewModel">
      <views:AssetLibraryView DataContext="{Binding Session}" />
    </DataTemplate>
    <DataTemplate DataType="vm:CharacterLibraryDocumentViewModel">
      <views:CharacterLibraryView DataContext="{Binding Session}" />
    </DataTemplate>
  </Window.DataTemplates>
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="#292C31">
      <MenuItem Header="_Файл">
        <MenuItem Header="Создать проект" Command="{Binding NewCommand}" InputGesture="Ctrl+N" />
        <MenuItem Header="Открыть проект…" Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
        <Separator />
        <MenuItem Header="Сохранить" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
        <MenuItem Header="Сохранить как…" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
        <MenuItem Header="Закрыть проект" Command="{Binding CloseProjectCommand}" InputGesture="Ctrl+W" />
        <Separator /><MenuItem Header="Выход" Click="ExitClicked" />
      </MenuItem>
      <MenuItem Header="_Правка">
        <MenuItem Header="Отменить" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
        <MenuItem Header="Повторить" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
      </MenuItem>
      <MenuItem Header="_Проект" IsEnabled="{Binding HasProject}">
        <MenuItem Header="Параметры проекта" Click="ProjectSettingsClicked" />
        <Separator />
        <MenuItem Header="Добавить сцену" Command="{Binding AddSceneCommand}" />
        <MenuItem Header="Удалить текущую сцену" Command="{Binding DeleteSceneCommand}" />
        <MenuItem Name="OpenScreenLibraryMenu" Header="Холст текущей сцены" Command="{Binding OpenScreenLibraryCommand}" />
        <MenuItem Header="Персонажи и состояния" Command="{Binding OpenCharacterLibraryCommand}" />
        <Separator />
        <MenuItem Header="Изображения проекта" Command="{Binding OpenAssetLibraryCommand}" />
        <MenuItem Header="Импортировать изображение…" Command="{Binding ImportImageCommand}" />
        <MenuItem Name="OpenScriptLibraryMenu" Header="Lua-файлы проекта" Command="{Binding OpenScriptLibraryCommand}" />
      </MenuItem>
      <MenuItem Header="_Вид">
        <MenuItem Name="WorkspacePanelsMenu" Header="Панели" />
        <MenuItem Header="Восстановить расположение панелей" Click="ResetWorkspaceClicked" />
        <Separator /><MenuItem Header="Обновить файлы проекта и Git" Command="{Binding RefreshGitCommand}" InputGesture="F5" />
      </MenuItem>
      <MenuItem Header="_Запуск">
        <MenuItem Header="Запустить предпросмотр" Command="{Binding PreviewSceneCommand}" InputGesture="F6" />
        <Separator /><MenuItem Header="Открыть пример проекта" Command="{Binding OpenExampleCommand}" />
      </MenuItem>
      <MenuItem Header="_Сборка" IsEnabled="{Binding HasProject}">
        <MenuItem Name="ExportWindowsMenu" Header="Папка игры Windows x64…" Command="{Binding ExportWindowsCommand}" />
        <MenuItem Name="ExportWindowsInstallerMenu" Header="Установщик игры EXE…" Command="{Binding ExportWindowsInstallerCommand}" />
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" Background="#26292E" BorderBrush="#383C43" BorderThickness="0,0,0,1" Padding="8,5">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Name="NewProjectButton" Classes="tool" Content="Создать" Command="{Binding NewCommand}" ToolTip.Tip="Создать проект (Ctrl+N)" />
        <Button Name="OpenProjectButton" Classes="tool" Content="Открыть" Command="{Binding OpenCommand}" ToolTip.Tip="Открыть проект (Ctrl+O)" />
        <Button Name="SaveProjectButton" Classes="tool" Content="Сохранить" Command="{Binding SaveCommand}" ToolTip.Tip="Сохранить проект (Ctrl+S)" />
        <StackPanel IsVisible="{Binding HasProject}" Orientation="Horizontal" Spacing="4">
          <Border Width="1" Background="#444951" Margin="6,3" />
          <Button Classes="tool" Content="↶" Command="{Binding UndoCommand}" ToolTip.Tip="Отменить (Ctrl+Z)" AutomationProperties.Name="Отменить" />
          <Button Classes="tool" Content="↷" Command="{Binding RedoCommand}" ToolTip.Tip="Повторить (Ctrl+Y)" AutomationProperties.Name="Повторить" />
          <Border Width="1" Background="#444951" Margin="6,3" />
          <Button Name="AddSceneButton" Classes="tool" Content="+ Сцена" Command="{Binding AddSceneCommand}" />
          <Button Name="ScreenDesignerButton" Classes="tool" Content="Холст" Command="{Binding OpenScreenLibraryCommand}" />
          <Button Name="AssetLibraryButton" Classes="tool" Content="Изображения" Command="{Binding OpenAssetLibraryCommand}" />
          <Border Width="1" Background="#444951" Margin="6,3" />
          <Button Name="RunPreviewButton" Classes="tool" Content="▶ Запустить" Command="{Binding PreviewSceneCommand}" ToolTip.Tip="Предпросмотр (F6)" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="#383C43" BorderThickness="0,1,0,0" Background="#26292E" Padding="12,7">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding ProjectName}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding GitSummary}" Classes="muted" Margin="20,0,0,0" MaxWidth="460" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GitSummary}" />
      </Grid>
    </Border>
    <Grid>
    <Grid Name="Workspace" IsVisible="{Binding HasProject}">
        <Border Name="ExplorerPane" Background="#24262B">
          <DockPanel>


            <Grid>
            <views:ProjectFolderView Name="ProjectFolders" IsVisible="{Binding IsFolderExplorer}" IsEnabled="{Binding IsIdle}" />
            <TreeView IsVisible="{Binding !IsFolderExplorer}" Name="ProjectExplorer" ItemsSource="{Binding Explorer}" Margin="4,8" IsEnabled="{Binding IsIdle}" SelectionChanged="ExplorerSelectionChanged">
              <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="vm:ExplorerEntry" ItemsSource="{Binding Items}">
                  <Grid ColumnDefinitions="18,*" ToolTip.Tip="{Binding Detail}">
                    <views:ResourceIcon Entry="{Binding}" Width="16" Height="16" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
              <TreeView.Styles>
                <Style Selector="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, DataType=vm:ExplorerEntry}" />
                </Style>
              </TreeView.Styles>
            </TreeView>
            </Grid>
          </DockPanel>
        </Border>

        <Grid Name="DocumentsPane" Background="#202226">
          <TabControl Name="Documents" IsVisible="{Binding HasProject}" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument, Mode=TwoWay}">
            <TabControl.ItemTemplate>
              <DataTemplate DataType="vm:DocumentViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Header}" FontSize="13" VerticalAlignment="Center" />
                  <Button Content="×" Padding="4,0" Background="Transparent" IsVisible="{Binding CanClose}" Command="{Binding CloseCommand}" ToolTip.Tip="Закрыть вкладку" AutomationProperties.Name="Закрыть вкладку" />
                </StackPanel>
              </DataTemplate>
            </TabControl.ItemTemplate>
          </TabControl>
        </Grid>

        <Border Name="InformationPane" Background="#24262B">
          <views:ObjectPropertiesView Name="ObjectProperties" />
        </Border>
      <ContentControl Name="ScenePane" Content="{Binding ActiveScene}">
        <ContentControl.ContentTemplate>
          <DataTemplate DataType="vm:SceneDocumentViewModel">
            <DockPanel Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="{Binding CssError}" IsVisible="{Binding HasCssError}" Foreground="#D9B68C" TextWrapping="Wrap" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding PlaybackDiagnostics}" Foreground="#D9B68C" TextWrapping="Wrap" />
                <views:DialogueStyleSample Name="DialogueSample" StyleSheet="{Binding Style}" SampleText="{Binding SampleText}"
                    SampleFrame="{Binding SampleFrame}" PlacementEditor="{Binding}"
                    BackgroundImage="{Binding BackgroundImage}" ProjectDirectory="{Binding Session.ProjectDirectory}" AssetRevision="{Binding Session.AssetRevision}"
                    ShowVoiceProgress="{Binding Session.ShowVoiceProgress}" ShowVoiceControls="{Binding Session.ShowVoiceControls}"
                    ShowNavigationControls="{Binding Session.ShowNavigationControls}" PreviousCommand="{Binding PreviousLineCommand}" NextCommand="{Binding NextLineCommand}" />
            </DockPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
      <DockPanel Name="MessagesPane" Background="#24262B">

        <ListBox Name="DiagnosticsList" ItemsSource="{Binding Diagnostics}" Background="Transparent" FontSize="12" />
      </DockPanel>
    </Grid>
    <views:StartPage Name="StartPage" IsVisible="{Binding !HasProject}" />
    </Grid>
  </DockPanel>
</Window>
