<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:NovellMaker.Editor.Views"
             xmlns:vm="using:NovellMaker.Editor.ViewModels"
             x:Class="NovellMaker.Editor.Views.ProjectSettingsView" x:DataType="vm:EditorSession">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="12" MaxWidth="800" HorizontalAlignment="Stretch">
      <TextBlock Text="Параметры проекта" FontSize="22" FontWeight="Light" />
      <TextBlock Text="Название проекта" />
      <TextBox Name="ProjectNameBox" Text="{Binding ProjectName, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" IsUndoEnabled="False" PlaceholderText="Название новеллы" />
      <TextBlock Text="{Binding NameValidation}" Foreground="#D9B68C" />
      <TextBlock Text="Основной язык текста" />
      <TextBox Text="{Binding DefaultLanguage, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" IsUndoEnabled="False" PlaceholderText="ru, en, en-US…" />
      <TextBlock Text="{Binding DocumentValidation}" Foreground="#D9B68C" TextWrapping="Wrap" />
      <TextBlock Text="Вид обозревателя проекта" />
      <ComboBox Name="ExplorerModePicker" SelectedIndex="{Binding ExplorerModeIndex, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="Иерархия новеллы" />
        <ComboBoxItem Content="Папки и файлы" />
      </ComboBox>
      <TextBlock Text="Файл проекта" Classes="section" />
      <SelectableTextBlock Text="{Binding PathDisplay}" TextWrapping="Wrap" />
      <TextBlock Text="ПРОВЕРКА ВЫПУСКА ИГРЫ" Classes="section" Margin="0,14,0,0" />
      <CheckBox Name="ReleaseCheckEnabledBox" Content="Разрешить проверку выпусков GitHub Releases" IsChecked="{Binding ReleaseCheckEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
      <TextBlock Text="Провайдер: публичный GitHub Releases. Запрос выполняется только по команде Lua. Авторизация не используется." TextWrapping="Wrap" />
      <StackPanel Spacing="8" IsVisible="{Binding ReleaseCheckEnabled}" IsEnabled="{Binding CanEdit}">
        <TextBlock Text="Владелец репозитория" />
        <TextBox Name="ReleaseCheckOwnerBox" Text="{Binding ReleaseCheckOwner, Mode=TwoWay}" IsUndoEnabled="False" PlaceholderText="author" />
        <TextBlock Text="Репозиторий" />
        <TextBox Name="ReleaseCheckRepositoryBox" Text="{Binding ReleaseCheckRepository, Mode=TwoWay}" IsUndoEnabled="False" PlaceholderText="my-novel" />
        <TextBlock Text="Версия этой поставки игры" />
        <TextBox Name="ReleaseCheckVersionBox" Text="{Binding ReleaseCheckVersion, Mode=TwoWay}" IsUndoEnabled="False" PlaceholderText="1.0.0" />
        <TextBlock Text="Только публичные метаданные выпуска. Не вводите токены или пароли." TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Name="ReleaseCheckValidationText" Text="{Binding ReleaseCheckValidation}" Foreground="#D9B68C" TextWrapping="Wrap" />
      <TextBlock Text="ВОСПРОИЗВЕДЕНИЕ ЗВУКА" Classes="section" />
      <StackPanel Spacing="6" IsEnabled="{Binding CanEdit}">
        <TextBlock Text="Плавное начало источников, с (0 — сразу)" />
        <NumericUpDown Name="AudioFadeInBox" Value="{Binding AudioFadeInSeconds, Mode=TwoWay}" Minimum="0" Maximum="30" Increment="0.05" FormatString="0.##" />
        <TextBlock Text="Затухание записей и уход музыки сцены, с" />
        <NumericUpDown Name="AudioFadeOutBox" Value="{Binding AudioFadeOutSeconds, Mode=TwoWay}" Minimum="0" Maximum="30" Increment="0.05" FormatString="0.##" />
        <TextBlock Text="Перекрёстное затухание sound при смене сцен, с" />
        <NumericUpDown Name="AudioCrossfadeBox" Value="{Binding AudioCrossfadeSeconds, Mode=TwoWay}" Minimum="0" Maximum="30" Increment="0.05" FormatString="0.##" />
        <CheckBox Name="AudioDuckingBox" Content="Приглушать sound во время voice" IsChecked="{Binding AudioDuckingEnabled, Mode=TwoWay}" />
        <StackPanel Spacing="6" IsEnabled="{Binding AudioDuckingEnabled}">
          <TextBlock Text="Множитель громкости sound при озвучке (0–1)" />
          <NumericUpDown Value="{Binding AudioDuckingVolume, Mode=TwoWay}" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" />
          <TextBlock Text="Время приглушения / восстановления, с" />
          <NumericUpDown Value="{Binding AudioDuckingAttackSeconds, Mode=TwoWay}" Minimum="0" Maximum="30" Increment="0.05" FormatString="0.##" />
          <NumericUpDown Value="{Binding AudioDuckingReleaseSeconds, Mode=TwoWay}" Minimum="0" Maximum="30" Increment="0.05" FormatString="0.##" />
        </StackPanel>
      </StackPanel>
      <TextBlock Text="ДИАЛОГОВЫЙ ИНТЕРФЕЙС" Classes="section" Margin="0,14,0,0" />
      <CheckBox Content="Показывать прогресс озвучки" IsChecked="{Binding ShowVoiceProgress, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
      <CheckBox Content="Показывать паузу и продолжение озвучки" IsChecked="{Binding ShowVoiceControls, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
      <CheckBox Content="Показывать кнопки «Назад» и «Вперёд»" IsChecked="{Binding ShowNavigationControls, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
      <TextBlock Text="Общий CSS плашки" />
      <TextBox Name="ProjectCssBox" Text="{Binding DialogueCss, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, DejaVu Sans Mono, monospace" FontSize="12" MinHeight="200" IsUndoEnabled="False" IsEnabled="{Binding CanEdit}" />
      <TextBlock Text="{Binding ProjectCssError}" Foreground="#D9B68C" TextWrapping="Wrap" />
      <views:HelpTip Explanation="Сцены наследуют этот стиль, если в них не задан собственный. Ошибочный CSS сохраняется как черновик; образец продолжает показывать последний корректный стиль." />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Content="Сохранить" Command="{Binding SaveCommand}" />
        <Button Content="Сохранить как…" Command="{Binding SaveAsCommand}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
