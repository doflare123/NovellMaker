<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:NovellMaker.Editor.Views"
             x:Class="NovellMaker.Editor.Views.DialogueStyleSample"
             x:Name="Root" x:DataType="views:DialogueStyleSample">
  <StackPanel Spacing="8">
    <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
      <Canvas Width="1280" Height="400" Background="#15171B" ClipToBounds="True">
        <Border Name="DialoguePlate" RenderTransformOrigin="50%,50%">
          <StackPanel Spacing="12">
            <TextBlock Name="DialogueText" Text="{Binding #Root.SampleText}" TextWrapping="Wrap" />
            <StackPanel Name="VoiceProgressPanel" IsVisible="{Binding #Root.ShowVoiceProgress}">
              <ProgressBar Minimum="0" Maximum="1" Value="0" Height="4" />
              <TextBlock Text="Нет озвучки" Foreground="#AEB4BD" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Назад" Command="{Binding #Root.PreviousCommand}" IsVisible="{Binding #Root.ShowNavigationControls}" FontSize="16" />
              <Button Content="Вперёд" Command="{Binding #Root.NextCommand}" IsVisible="{Binding #Root.ShowNavigationControls}" FontSize="16" />
              <Button Name="PauseVoiceButton" Content="Пауза / продолжить" IsVisible="{Binding #Root.ShowVoiceControls}" IsEnabled="False" FontSize="16" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Canvas>
    </Viewbox>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Name="PlayStyleAnimationButton" Content="Проиграть анимацию" Click="PlayClicked" />
      <Button Content="Остановить" Click="StopClicked" />
    </StackPanel>
  </StackPanel>
</UserControl>
