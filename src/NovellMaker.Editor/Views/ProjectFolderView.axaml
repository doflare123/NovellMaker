<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NovellMaker.Editor.ViewModels"
             xmlns:views="using:NovellMaker.Editor.Views"
             x:Class="NovellMaker.Editor.Views.ProjectFolderView" x:DataType="vm:ProjectFolderBrowser">
  <Grid Name="BrowserRoot" RowDefinitions="Auto,Auto,*,Auto" Background="#24262B">
    <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="4" ColumnSpacing="2">
      <Button Name="FolderBackButton" Content="←" Command="{Binding BackCommand}" Padding="6,3" ToolTip.Tip="Назад" AutomationProperties.Name="Назад по папкам" />
      <Button Grid.Column="1" Content="→" Command="{Binding ForwardCommand}" Padding="6,3" ToolTip.Tip="Вперёд" AutomationProperties.Name="Вперёд по папкам" />
      <Button Name="FolderUpButton" Grid.Column="2" Content="↑" Command="{Binding UpCommand}" Padding="6,3" ToolTip.Tip="На уровень выше" AutomationProperties.Name="На уровень выше" />
      <TextBox Name="FolderSearchBox" Grid.Column="3" Text="{Binding Search, Mode=TwoWay}" PlaceholderText="Поиск в папке" MinWidth="60" IsUndoEnabled="False" />
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="4,0,4,4">
      <ItemsControl ItemsSource="{Binding Breadcrumbs}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate DataType="vm:FolderBreadcrumb">
          <Button Content="{Binding Name}" Click="BreadcrumbClicked" Padding="5,3" FontSize="11" Background="Transparent" />
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Grid Name="BrowserColumns" Grid.Row="2" ColumnDefinitions="110,4,*">
      <TreeView Name="FolderNavigation" ItemsSource="{Binding Roots}" SelectionChanged="FolderSelectionChanged" Background="#202226">
        <TreeView.ItemTemplate><TreeDataTemplate DataType="vm:ExplorerEntry" ItemsSource="{Binding Folders}">
          <Grid ColumnDefinitions="16,*" ToolTip.Tip="{Binding Detail}">
            <views:ResourceIcon Entry="{Binding}" Width="16" Height="16" />
            <TextBlock Grid.Column="1" Text="{Binding FolderName}" FontSize="11" TextTrimming="CharacterEllipsis" />
          </Grid>
        </TreeDataTemplate></TreeView.ItemTemplate>
        <TreeView.Styles><Style Selector="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, DataType=vm:ExplorerEntry}" /></Style></TreeView.Styles>
      </TreeView>
      <GridSplitter Name="FolderNavigationSplitter" Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#363A40" />
      <Grid Grid.Column="2">
        <ListBox Name="FolderTiles" ItemsSource="{Binding Tiles}" SelectedItem="{Binding SelectedTile, Mode=TwoWay}"
                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 DoubleTapped="TileDoubleTapped" Padding="4">
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="3" /><Setter Property="Margin" Value="2" /></Style></ListBox.Styles>
          <ListBox.ItemTemplate><DataTemplate DataType="vm:FolderTile">
            <StackPanel Width="88" Height="96" Spacing="5" ToolTip.Tip="{Binding Detail}">
              <Grid Width="72" Height="56">
                <views:ResourceIcon Entry="{Binding Entry}" IsVisible="{Binding !HasImage}" />
                <views:ProjectImageView Asset="{Binding Image}" ProjectDirectory="{Binding ProjectDirectory}" Revision="{Binding Revision}" MaximumWidth="128" IsVisible="{Binding HasImage}" />
                <Border IsVisible="{Binding HasGitStatus}" Background="#292D32" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                  <TextBlock Text="{Binding GitStatus}" FontSize="10" Foreground="#D9B68C" />
                </Border>
              </Grid>
              <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" FontSize="11" />
            </StackPanel>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}" IsHitTestVisible="False" Classes="muted" TextWrapping="Wrap" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
    </Grid>
    <TextBlock Grid.Row="3" Text="{Binding SelectionDetail}" TextTrimming="CharacterEllipsis" Classes="muted" FontSize="11" Margin="6" ToolTip.Tip="{Binding SelectionDetail}" />
  </Grid>
</UserControl>
