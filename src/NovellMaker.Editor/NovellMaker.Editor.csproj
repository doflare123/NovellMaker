<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaVersion>12.1.0</AvaloniaVersion>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NovellMaker.Editor.Tests" />
    <ProjectReference Include="../NovellMaker.Core/NovellMaker.Core.csproj" />
    <ProjectReference Include="../NovellMaker.Runtime/NovellMaker.Runtime.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>
  <Target Name="CopyRuntimeHost" AfterTargets="Build">
    <ItemGroup>
      <RuntimeHostFile Include="$(MSBuildProjectDirectory)/../NovellMaker.Runtime/bin/$(Configuration)/$(TargetFramework)/**/*" Exclude="$(MSBuildProjectDirectory)/../NovellMaker.Runtime/bin/$(Configuration)/$(TargetFramework)/win-x64/**/*;$(MSBuildProjectDirectory)/../NovellMaker.Runtime/bin/$(Configuration)/$(TargetFramework)/publish/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeHostFile)" DestinationFiles="@(RuntimeHostFile->'$(TargetDir)Runtime/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyWindowsExportTemplate" AfterTargets="Build">
    <PropertyGroup>
      <ExportTemplateRoot>$(MSBuildProjectDirectory)/../../artifacts/export-templates/win-x64/</ExportTemplateRoot>
      <ExportTemplateOutput>$(TargetDir)ExportTemplates/win-x64/</ExportTemplateOutput>
    </PropertyGroup>
    <ItemGroup>
      <ExportTemplateFile Include="$(ExportTemplateRoot)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ExportTemplateFile)" DestinationFiles="@(ExportTemplateFile->'$(ExportTemplateOutput)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishWindowsExportTemplate" AfterTargets="Publish" DependsOnTargets="CopyWindowsExportTemplate">
    <Copy SourceFiles="@(ExportTemplateFile)" DestinationFiles="@(ExportTemplateFile->'$(PublishDir)ExportTemplates/win-x64/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishRuntimeHost" AfterTargets="Publish" DependsOnTargets="CopyRuntimeHost">
    <Copy SourceFiles="@(RuntimeHostFile)" DestinationFiles="@(RuntimeHostFile->'$(PublishDir)Runtime/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyWindowsInstallerCompiler" AfterTargets="Build">
    <ItemGroup>
      <InstallerCompilerFile Include="$(MSBuildProjectDirectory)/../../artifacts/build-tools/nsis-3.13/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(InstallerCompilerFile)" DestinationFiles="@(InstallerCompilerFile->'$(TargetDir)BuildTools/NSIS/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishWindowsInstallerCompiler" AfterTargets="Publish" DependsOnTargets="CopyWindowsInstallerCompiler">
    <Copy SourceFiles="@(InstallerCompilerFile)" DestinationFiles="@(InstallerCompilerFile->'$(PublishDir)BuildTools/NSIS/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
