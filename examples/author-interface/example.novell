        {
          "lineId": "56f7995f-ef1f-4079-adef-6a5b1e94bd3f",
          "phase": "DuringLine",
          "action": {
            "kind": "script",
            "source": "if game.get(\"input.object\") == refs.correct then\r\n    game.finish(\"win\")\r\nelse\r\n    game.finish(\"lose\")\r\nend",
            "name": "terminal-result.lua",
