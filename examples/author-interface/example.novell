  "scripts": [
    {
      "id": "8fec22d4-369c-4987-8f3e-48df8e25d51f",
      "name": "terminal-start.lua",
      "source": "-- Очередь останавливается до щелчка; результат читает следующий Lua-блок.\ngame.wait_click()\n",
      "references": {}
    },
    {
      "id": "7573ae59-283b-438e-8bc5-950c7b22dd48",
      "name": "example-menu.lua",
      "source": "local live_badge\nreturn {\n  on_load = function()\n    ui.set_text(refs.title, \"Меню проекта-примера\")\n    live_badge = ui.create(refs.badge, refs.panel)\n    ui.set_visible(live_badge, true)\n    ui.set_geometry(live_badge, {rotation=-5, opacity=0.8, color='#80CCFF'})\n    ui.set_text(live_badge, \"Живой экземпляр · ui.create\")\n  end,\n  on_event = function(event)\n    if event.node == refs.resume then ui.remove(live_badge); ui.close() end\n  end\n}",
      "references": {}
    }
  ],
